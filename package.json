{
  "name": "ostrov",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Остров — система мониторинга рыбоводного хозяйства (React + FSD + статичный HTML)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:static": "node scripts/build-static.mjs",
    "build:site": "node scripts/build-site.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fsd": "steiger src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "commit": "cz",
    "prepare": "lefthook install"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "chart.js": "^4.4.6",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.15.0",
    "@feature-sliced/steiger-plugin": "^0.5.6",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "lefthook": "^1.10.10",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "steiger": "^0.5.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11"
  },
  "packageManager": "pnpm@11.5.1"
}
